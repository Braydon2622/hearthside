{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearthside",
  "version": "0.1.0",
  "identifier": "app.hearthside.wallpaper",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "wallpaper",
        "title": "Hearthside",
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
